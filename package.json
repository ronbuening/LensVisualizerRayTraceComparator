{
  "name": "lensvisualizer-raytrace-comparator",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-checks LensVisualizer's ray trace and MTF against external optical engines.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "lvrtc": "bin/lvrtc.mjs"
  },
  "scripts": {
    "lvrtc": "node bin/lvrtc.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.mjs\" \"*.config.js\" \"*.json\" \"contract/schema/**/*.json\" \"suites/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.mjs\" \"*.config.js\" \"*.json\" \"contract/schema/**/*.json\" \"suites/*.json\"",
    "test": "node --test \"test/*.test.ts\" \"test/!(integration)/**/*.test.ts\"",
    "test:lv": "node --test \"test/integration/lv/**/*.test.ts\"",
    "test:optiland": "node --test \"test/integration/optiland/**/*.test.ts\"",
    "test:python": "python3 -B -m unittest discover -s workers/python/tests/kit -t workers/python && python3 -B -m unittest discover -s workers/python/tests/optiland -t workers/python",
    "verify": "node bin/lvrtc.mjs verify",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:python && npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
