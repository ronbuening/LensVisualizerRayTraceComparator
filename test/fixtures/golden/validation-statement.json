n rule.","Models of vignetting. Each engine clips rays at the apertures it is handed; how an engine's own MTF fills, samples and calibrates a clipped pupil is its method, and a difference that comes of it is written down, not explained.","Zoom and focus positions other than the states a run names, and the catalog beyond these suites.","Fields that an engine's own convergence test did not pass. Their figures are shown apart and enter no band."],"policy":{"hash":"b32032395aa189b6f09936b542be7154e4d611122d299340bb341ba713f7312a","version":1},"rungs":[{"compares":"Built layout, shape, aperture, index and sampled sag","configurationPairs":16,"configurations":8,"diagnostics":{},"limits":[{"kind":"tolerance","metric":"synthetic.maxAbs","unit":"1","value":0.125},{"kind":"tolerance","metric":"synthetic.zero","unit":"elements","value":0}],"metrics":[{"measuredRequests":32,"name":"synthetic.maxAbs","worst":{"a":"lv","b":"optiland","measured":2,"name":"synthetic.maxAbs","run":"artificial-line","suite":"benchmark","tolerance":0.125,"unit":"1","value":0.015625,"where":{"field":0}}},{"measuredRequests":32,"name":"synthetic.zero","worst":{"a":"lv","b":"optiland","name":"synthetic.zero","run":"artificial-line","suite":"benchmark","tolerance":0,"unit":"elements","value":0}}],"mode":"gated","requestPairs":32,"rung":"r0","verdicts":[{"count":32,"verdict":"PASS"}],"worst":{"a":"lv","b":"optiland","measured":2,"name":"synthetic.maxAbs","run":"artificial-line","suite":"benchmark","tolerance":0.125,"unit":"1","value":0.015625,"where":{"field":0}}},{"compares":"First-order quantities and pupils","configurationPairs":16,"configurations":8,"diagnostics":{},"limits":[{"kind":"tolerance","metric":"synthetic.maxAbs","unit":"1","value":0.125},{"kind":"tolerance","metric":"synthetic.zero","unit":"elements","value":0}],"metrics":[{"measuredRequests":32,"name":"synthetic.maxAbs","worst":{"a":"lv","b":"optiland","measured":2,"name":"synthetic.maxAbs","run":"artificial-line","suite":"benchmark","toler