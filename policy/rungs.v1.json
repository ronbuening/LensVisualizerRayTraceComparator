        "layout.mismatches": { "tolerance": 0, "unit": "elements" },
        "sag.maxScaled": { "tolerance": 1e-12, "unit": "1" },
        "shape.mismatches": { "tolerance": 0, "unit": "elements" }
      },
      "blocksLaterRungs": true
    },
    "r1": {
      "quantity": "paraxial.first-order",
      "mode": "direct",
      "class": "gated",
      "metrics": {
