{
  "contract": "1.3",
  "kind": "policy",
  "version": 17,
  "rungs": {
    "selftest": {
      "quantity": "selftest.echo",
      "mode": "direct",
      "class": "gated",
      "metrics": {
        "sum.abs": { "tolerance": 1e-12, "unit": "1" },
        "values.maxAbs": { "tolerance": 1e-12, "unit": "1" }
      }
    },
    "r0": {
      "quantity": "system.describe",
      "mode": "direct",
      "class": "gated",
      "metrics": {
        "aperture.mismatches": { "tolerance": 0, "unit": "elements" },
        "index.mismatches": { "tolerance": 0, "unit": "elements" },
        "layout.mismatches": { "tolerance": 0, "unit": "elements" },
        "sag.maxScaled": { "tolerance": 1e-12, "unit": "1" },
        "shape.mismatches": { "tolerance": 0, "unit": "elements" }
      },
      "blocksLaterRungs": true
    },
    "r1": {
      "quantity": "paraxial.first-order",
      "mode": "direct",
      "class": "gated",
      "metrics": {
        "firstOrder.maxAbs": { "tolerance": 1e-9, "unit": "mm" },
        "pupilRadius.maxScaled": { "tolerance": 1e-9, "unit": "mm" },
        "pupilZ.maxScaled": { "tolerance": 1e-9, "unit": "mm" }
      }
    },
    "r2": {
      "quantity": "rays.trace",
      "mode": "identical-rays",
      "class": "gated",
      "metrics": {
        "direction.maxAbs": { "tolerance": 1e-9, "unit": "1" },
        "hits.maxDistance": { "tolerance": 1e-8, "unit": "mm" },
        "landing.maxDistance": { "tolerance": 1e-8, "unit": "mm" },
        "mask.mismatches": { "tolerance": 0, "unit": "rays" }
      }
    },
    "r3": {
      "quantity": "rays.trace",
      "mode": "identical-rays",
      "class": "gated",
      "metrics": {
        "opd.maxAbs": { "tolerance": 2e-5, "unit": "waves" },
        "opticalPath.maxAbs": { "tolerance": 2e-5, "unit": "waves" },
        "opticalPathToImage.maxAbs": {
          "tolerance": 2e-5,
          "unit": "waves"
        },
        "phasePath.maxAbs": { "tolerance": 2e-5, "unit": "waves" }
      }
    },
    "r4": {
      "quantity": "rays.trace",
      "mode": "identical-rays",
      "class": "gated",
      "metrics": {
        "mtf.maxAbs": { "tolerance": 1e-7, "unit": "1" }
      }
    },
    "r4f": {
      "quantity": "mtf.native",
      "mode": "direct",
      "class": "gated",
      "metrics": {
        "fields.mismatches": { "tolerance": 0, "unit": "elements" },
        "mtf.maxAbs": { "tolerance": 1e-9, "unit": "1" },
        "sampling.mismatches": { "tolerance": 0, "unit": "elements" }
      }
    },
    "r5": {
      "quantity": "mtf.native",
      "mode": "independent-method",
      "class": "recorded",
      "metrics": {
        "chiefLanding.maxAbs": { "attention": 1e-7, "unit": "mm" },
        "mtfOffAxis.maxAbs": { "attention": 0.01, "unit": "1" },
        "mtfOnAxis.maxAbs": { "attention": 0.005, "unit": "1" }
      }
    },
    "r5g": {
      "quantity": "mtf.native",
      "mode": "independent-method",
      "class": "recorded",
      "metrics": {
        "chiefLanding.maxAbs": { "attention": 1e-3, "unit": "mm" },
        "mtfOffAxis.maxAbs": { "attention": 0.01, "unit": "1" },
        "mtfOnAxis.maxAbs": { "attention": 0.005, "unit": "1" }
      }
    },
    "r6a": {
      "quantity": "rays.trace",
      "mode": "identical-rays",
      "class": "gated",
      "metrics": {
        "waveMtf.maxAbs": { "tolerance": 2e-8, "unit": "1" }
      }
    },
    "r6b": {
      "quantity": "mtf.native",
      "mode": "independent-method",
      "class": "recorded",
      "metrics": {
        "mtfOffAxis.maxAbs": { "attention": 0.01, "unit": "1" },
        "mtfOnAxis.maxAbs": { "attention": 0.005, "unit": "1" }
      }
    },
    "r6c": {
      "quantity": "mtf.native",
      "mode": "independent-method",
      "class": "recorded",
      "metrics": {
        "chiefLanding.maxAbs": { "attention": 1e-7, "attentionSeveralLines": 1e-3, "unit": "mm" },
        "mtfOffAxis.maxAbs": { "attention": 0.01, "unit": "1" },
        "mtfOnAxis.maxAbs": { "attention": 0.005, "unit": "1" }
      }
    },
    "r7a": {
      "quantity": "rays.trace",
      "mode": "identical-rays",
      "class": "gated",
      "metrics": {
        "centroid.maxAbs": { "tolerance": 1e-8, "unit": "mm" },
        "mask.mismatches": { "tolerance": 0, "unit": "rays" },
        "rmsRadius.maxAbs": { "tolerance": 1e-8, "unit": "mm" },
        "transverseError.maxAbs": { "tolerance": 1e-8, "unit": "mm" }
      }
    },
    "r7b": {
      "quantity": "spot.native",
      "mode": "independent-method",
      "class": "recorded",
      "metrics": {
        "chiefLanding.maxAbs": { "attention": 1e-5, "unit": "mm" },
        "fanError.maxAbs": { "unit": "mm" },
        "spotCentroid.maxAbs": { "unit": "mm" },
        "spotRmsRadius.maxAbs": { "unit": "mm" }
      }
    },
    "r8a": {
      "quantity": "rays.trace",
      "mode": "identical-rays",
      "class": "gated",
      "metrics": {
        "focus.maxScaled": { "tolerance": 1e-8, "unit": "mm" },
        "focusRms.maxAbs": { "tolerance": 1e-8, "unit": "mm" },
        "intercept.maxScaled": { "tolerance": 1e-8, "unit": "mm" },
        "mask.mismatches": { "tolerance": 0, "unit": "rays" }
      }
    },
    "r8b": {
      "quantity": "axial.native",
      "mode": "independent-method",
      "class": "recorded",
      "metrics": {
        "bestFocus.maxAbs": { "attention": 1e-10, "unit": "mm" },
        "bestFocusRms.maxAbs": { "attention": 1e-10, "unit": "mm" },
        "landing.maxAbs": { "attention": 1e-5, "unit": "mm" },
        "lineFocus.maxAbs": { "unit": "mm" },
        "longitudinalSa.maxAbs": { "attention": 1e-10, "unit": "mm" },
        "marginalIntercept.maxAbs": { "attention": 1e-10, "unit": "mm" },
        "nearAxisIntercept.maxAbs": { "attention": 1e-10, "unit": "mm" },
        "paraxialFocalShift.maxAbs": { "unit": "mm" },
        "profile.maxAbs": { "attention": 1e-10, "unit": "mm" },
        "pupilRadius.relative": { "attention": 2e-10, "unit": "1" },
        "relativeFocus.maxAbs": { "unit": "mm" }
      }
    }
  }
}
